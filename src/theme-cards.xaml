<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ThemeCardContainer" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Selection" Background="{DynamicResource Manager.Surface}" BorderBrush="{DynamicResource Manager.Border}" BorderThickness="2" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Manager.Accent}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Manager.Accent}"/><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Manager.AccentSoft}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource Manager.Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <ItemsPanelTemplate x:Key="ThemeCardPanel"><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
  <DataTemplate x:Key="ThemeCardTemplate">
    <Border Width="{Binding CardWidth}" CornerRadius="8" ClipToBounds="True" ToolTip="{Binding Tooltip}">
      <StackPanel>
        <Grid Height="{Binding ThumbnailHeight}" ClipToBounds="True">
          <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DBEAFE" Offset="0"/><GradientStop Color="#EDE9FE" Offset="1"/></LinearGradientBrush></Border.Background></Border>
          <TextBlock Text="{Binding PreviewHint}" Visibility="{Binding PlaceholderVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Manager.Muted}" FontSize="12"/>
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" Padding="6,2" CornerRadius="4" Background="{Binding ModeBackground}">
            <TextBlock Text="{Binding ModeLabel}" Foreground="{Binding ModeForeground}" FontSize="10.5"/>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="6,2" CornerRadius="4" Background="#E6162539" Visibility="{Binding StateVisibility}">
            <TextBlock Text="{Binding StateLabel}" Foreground="White" FontSize="10.5"/>
          </Border>
          <Button x:Name="ThemeFavoriteButton" Content="{Binding FavoriteGlyph}" Tag="{Binding ThemeId}" ToolTip="{Binding FavoriteTip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="27" Height="26" FontSize="19" FontFamily="Segoe UI Symbol" Cursor="Hand">
            <Button.Style><Style TargetType="Button">
              <Setter Property="Foreground" Value="#475569"/><Setter Property="Background" Value="#F7FFFFFF"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
              <Style.Triggers><DataTrigger Binding="{Binding FavoriteGlyph}" Value="★"><Setter Property="Foreground" Value="#B45309"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#DBEAFE"/></Trigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
        </Grid>
        <StackPanel Margin="8,6,8,7">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Manager.Text}" FontSize="12.5" Height="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Manager.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
